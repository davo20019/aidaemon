CREATE UNIQUE INDEX idx_task_attempts_one_active
         ON task_attempts(task_id)
         WHERE status IN ('claimed', 'running')

index idx_task_attempts_lease on task_attempts
CREATE INDEX idx_task_attempts_lease
         ON task_attempts(status, lease_expires_at)

index idx_task_journal_task_created on task_journal
CREATE INDEX idx_task_journal_task_created
         ON task_journal(task_id, created_at)

index idx_task_handoffs_task_created on task_handoffs
CREATE INDEX idx_task_handoffs_task_created
         ON task_handoffs(task_id, created_at)

index idx_task_workspaces_task on task_workspaces
CREATE INDEX idx_task_workspaces_task
         ON task_workspaces(task_id, created_at)

index idx_task_activity_task_created_at on task_activity
CREATE INDEX idx_task_activity_task_created_at ON task_activity(task_id, created_at)

index idx_scheduled_run_state_root_task on scheduled_run_state
CREATE INDEX idx_scheduled_run_state_root_task
         ON scheduled_run_state(root_task_id)

table notification_queue on notification_queue
CREATE TABLE notification_queue (
            id TEXT PRIMARY KEY,
            goal_id TEXT NOT NULL,
            session_id TEXT NOT NULL,
            notification_type TEXT NOT NULL,
            priority TEXT NOT NULL DEFAULT 'status_update',
            message TEXT NOT NULL,
            created_at TEXT NOT NULL DEFAULT (datetime('now')),
            delivered_at TEXT,
            attempts INTEGER NOT NULL DEFAULT 0,
            expires_at TEXT
        , task_id TEXT, action_token TEXT, untrusted INTEGER NOT NULL DEFAULT 0)

index idx_notification_queue_pending on notification_queue
CREATE INDEX idx_notification_queue_pending
         ON notification_queue(delivered_at, priority, created_at)
         WHERE delivered_at IS NULL

table token_alert_state on token_alert_state
CREATE TABLE token_alert_state (
            scope_type TEXT NOT NULL,
            scope_id TEXT NOT NULL,
            last_alert_at TEXT NOT NULL,
            last_metric_tokens INTEGER NOT NULL DEFAULT 0,
            last_metric_calls INTEGER NOT NULL DEFAULT 0,
            PRIMARY KEY (scope_type, scope_id)
        )

table conversation_summaries on conversation_summaries
CREATE TABLE conversation_summaries (
            session_id TEXT PRIMARY KEY,
            summary TEXT NOT NULL,
            message_count INTEGER NOT NULL DEFAULT 0,
            last_message_id TEXT NOT NULL,
            last_turn_seq INTEGER,
            updated_at TEXT NOT NULL
        )

table prompt_snapshots on prompt_snapshots
CREATE TABLE prompt_snapshots (
            hash TEXT PRIMARY KEY,
            content TEXT NOT NULL,
            created_at TEXT NOT NULL
        )

table background_spawns on background_spawns
CREATE TABLE background_spawns (
            id TEXT PRIMARY KEY,
            session_id TEXT NOT NULL,
            mission TEXT NOT NULL,
            started_at TEXT NOT NULL
        )

table task_dependencies on task_dependencies
CREATE TABLE task_dependencies (
            task_id TEXT NOT NULL REFERENCES tasks(id) ON DELETE CASCADE,
            depends_on_task_id TEXT NOT NULL REFERENCES tasks(id) ON DELETE CASCADE,
            created_at TEXT NOT NULL DEFAULT (datetime('now')),
            PRIMARY KEY(task_id, depends_on_task_id),
            CHECK(task_id <> depends_on_task_id)
        )

index idx_task_dependencies_prerequisite on task_dependencies
CREATE INDEX idx_task_dependencies_prerequisite
         ON task_dependencies(depends_on_task_id, task_id)

trigger trg_task_dependencies_no_cycle on task_dependencies
CREATE TRIGGER trg_task_dependencies_no_cycle
         BEFORE INSERT ON task_dependencies
         WHEN EXISTS (
            WITH RECURSIVE prerequisites(id) AS (
                SELECT NEW.depends_on_task_id
                UNION
                SELECT edge.depends_on_task_id
                FROM task_dependencies edge
                JOIN prerequisites prior ON edge.task_id = prior.id
            )
            SELECT 1 FROM prerequisites WHERE id = NEW.task_id
         )
         BEGIN
            SELECT RAISE(ABORT, 'task dependency cycle');
         END

table history_message_index on history_message_index
CREATE TABLE history_message_index (
            event_id INTEGER PRIMARY KEY,
            session_id TEXT NOT NULL,
            task_id TEXT,
            turn_id TEXT,
            message_id TEXT,
            role TEXT NOT NULL CHECK(role IN ('user', 'assistant')),
            created_at TEXT NOT NULL,
            channel_id TEXT,
            channel_visibility TEXT NOT NULL DEFAULT 'internal',
            user_role TEXT,
            source_kind TEXT NOT NULL DEFAULT 'root'
        )

index idx_history_session_event on history_message_index
CREATE INDEX idx_history_session_event ON history_message_index(session_id, event_id)

index idx_history_task_event on history_message_index
CREATE INDEX idx_history_task_event ON history_message_index(task_id, event_id)

index idx_history_channel_event on history_message_index
CREATE INDEX idx_history_channel_event ON history_message_index(channel_id, event_id)

index idx_history_source_event on history_message_index
CREATE INDEX idx_history_source_event ON history_message_index(source_kind, event_id)

table history_projection_state on history_projection_state
CREATE TABLE history_projection_state (
            key TEXT PRIMARY KEY,
            value INTEGER NOT NULL
        )

table state_schema_versions on state_schema_versions
CREATE TABLE state_schema_versions (
            version INTEGER PRIMARY KEY,
            name TEXT NOT NULL,
            applied_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))
        )

