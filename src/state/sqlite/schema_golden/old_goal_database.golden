CREATE INDEX idx_goal_runs_open
         ON goal_runs(goal_id, status)
         WHERE status IN ('pending', 'running', 'blocked')

index idx_tasks_goal_run_status on tasks
CREATE INDEX idx_tasks_goal_run_status
         ON tasks(goal_run_id, status)

