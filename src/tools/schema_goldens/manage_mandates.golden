{
  "description": "Draft, create, inspect, and govern owner-confirmed ongoing mandates.",
  "name": "manage_mandates",
  "schema": {
    "description": "Draft, create, inspect, and govern owner-confirmed ongoing mandates.",
    "name": "manage_mandates",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "draft",
            "create",
            "list",
            "get",
            "update",
            "transfer_owner",
            "pause",
            "resume",
            "answer_question",
            "resolve_reconciliation",
            "cancel",
            "record_measurement",
            "record_decision",
            "list_intentions"
          ],
          "type": "string"
        },
        "activity_level": {
          "enum": [
            "quiet",
            "active",
            "urgent"
          ],
          "type": "string"
        },
        "allow_observations": {
          "type": "boolean"
        },
        "attributed_intention_ids": {
          "items": {
            "maxLength": 256,
            "type": "string"
          },
          "maxItems": 16,
          "type": "array"
        },
        "autonomy_mode": {
          "enum": [
            "bounded",
            "autopilot"
          ],
          "type": "string"
        },
        "clear_strategy": {
          "type": "boolean"
        },
        "constraints": {
          "description": "Owner-facing guardrail. Use one short plain-language rule per item; split compound rules and avoid implementation jargon.",
          "items": {
            "maxLength": 500,
            "type": "string"
          },
          "maxItems": 16,
          "type": "array"
        },
        "default_review_minutes": {
          "minimum": 1,
          "type": "integer"
        },
        "duration_minutes": {
          "description": "Create only, relative to activation. Updates ignore this field; use expires_at to change an existing mandate's expiry.",
          "minimum": 1,
          "type": "integer"
        },
        "evidence_receipt_ids": {
          "description": "Optional. Omit to cite this run's successful observations automatically. To cite specific ones, use the tool_call_id you issued (e.g. call_...) or the result_id in that result's receipt footer (e.g. sha256:...); receipts from other runs, failed calls, or invented IDs are rejected.",
          "items": {
            "maxLength": 256,
            "type": "string"
          },
          "maxItems": 16,
          "type": "array"
        },
        "expected_benefit": {
          "description": "ACT: benefit of acting now instead of waiting.",
          "maxLength": 4096,
          "type": "string"
        },
        "expires_at": {
          "description": "RFC3339 fixed deadline. Supported by both create and update.",
          "type": "string"
        },
        "guidance": {
          "maxLength": 1024,
          "type": "string"
        },
        "include_terminal": {
          "type": "boolean"
        },
        "intention": {
          "maxLength": 1024,
          "type": "string"
        },
        "invalidation_criteria": {
          "description": "ACT: evidence making the intervention unsafe or not worthwhile.",
          "maxLength": 4096,
          "type": "string"
        },
        "learning_evidence_receipt_ids": {
          "description": "Optional. Receipts backing learning_note; they must also back this decision. Omit to cite the decision's evidence.",
          "items": {
            "maxLength": 256,
            "type": "string"
          },
          "maxItems": 16,
          "type": "array"
        },
        "learning_note": {
          "maxLength": 1024,
          "type": "string"
        },
        "limit": {
          "maximum": 10,
          "minimum": 1,
          "type": "integer"
        },
        "mandate_id": {
          "maxLength": 256,
          "type": "string"
        },
        "max_mutating_actions_per_cycle": {
          "maximum": 24,
          "minimum": 0,
          "type": "integer"
        },
        "max_mutating_actions_per_rolling_24h": {
          "maximum": 24,
          "minimum": 0,
          "type": "integer"
        },
        "max_review_minutes": {
          "minimum": 1,
          "type": "integer"
        },
        "measurement_confidence_bps": {
          "maximum": 10000,
          "minimum": 0,
          "type": "integer"
        },
        "measurement_observed_at": {
          "type": "string"
        },
        "measurement_value_micros": {
          "description": "Millionths of one unit (25 engagements = 25000000).",
          "type": "integer"
        },
        "min_review_minutes": {
          "minimum": 1,
          "type": "integer"
        },
        "min_seconds_between_mutations": {
          "minimum": 0,
          "type": "integer"
        },
        "objective": {
          "maxLength": 2048,
          "type": "string"
        },
        "objective_control": {
          "additionalProperties": false,
          "description": "Autopilot control loop. *_micros are millionths of one unit (25 engagements = 25000000). measurement_source is the exact authorized GET URL, with any query the metric needs.",
          "properties": {
            "baseline_micros": {
              "type": "integer"
            },
            "baseline_observed_at": {
              "type": "string"
            },
            "direction": {
              "enum": [
                "at_least",
                "at_most"
              ],
              "type": "string"
            },
            "experiment_cohort": {
              "maxLength": 128,
              "type": "string"
            },
            "experiment_window_secs": {
              "maximum": 7776000,
              "minimum": 60,
              "type": "integer"
            },
            "max_stagnant_measurements": {
              "maximum": 20,
              "minimum": 1,
              "type": "integer"
            },
            "measurement_cadence_secs": {
              "maximum": 2592000,
              "minimum": 60,
              "type": "integer"
            },
            "measurement_source": {
              "maxLength": 2048,
              "type": "string"
            },
            "metric_name": {
              "maxLength": 128,
              "type": "string"
            },
            "minimum_effect_micros": {
              "minimum": 1,
              "type": "integer"
            },
            "run_failure_budget": {
              "maximum": 10,
              "minimum": 1,
              "type": "integer"
            },
            "schema_version": {
              "enum": [
                1
              ],
              "type": "integer"
            },
            "target_micros": {
              "type": "integer"
            },
            "unit": {
              "maxLength": 64,
              "type": "string"
            }
          },
          "required": [
            "schema_version",
            "metric_name",
            "unit",
            "baseline_micros",
            "target_micros",
            "direction",
            "measurement_source",
            "measurement_cadence_secs",
            "experiment_cohort",
            "experiment_window_secs",
            "minimum_effect_micros",
            "max_stagnant_measurements",
            "run_failure_budget",
            "baseline_observed_at"
          ],
          "type": "object"
        },
        "observations": {
          "items": {
            "maxLength": 750,
            "type": "string"
          },
          "maxItems": 8,
          "type": "array"
        },
        "operation_scopes": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "allowed_query_params": {
                "items": {
                  "maxLength": 128,
                  "type": "string"
                },
                "maxItems": 16,
                "type": "array"
              },
              "kind": {
                "enum": [
                  "observation",
                  "mutation"
                ],
                "type": "string"
              },
              "mutation_effects": {
                "items": {
                  "enum": [
                    "remote_mutation",
                    "external_delivery"
                  ],
                  "type": "string"
                },
                "maxItems": 2,
                "type": "array"
              },
              "operation": {
                "enum": [
                  "GET",
                  "HEAD",
                  "OPTIONS",
                  "POST",
                  "PUT",
                  "PATCH",
                  "DELETE"
                ],
                "type": "string"
              },
              "target_prefixes": {
                "items": {
                  "maxLength": 2048,
                  "type": "string"
                },
                "maxItems": 16,
                "minItems": 1,
                "type": "array"
              },
              "tool": {
                "enum": [
                  "http_request",
                  "web_fetch"
                ],
                "type": "string"
              }
            },
            "required": [
              "tool",
              "operation",
              "kind",
              "target_prefixes",
              "allowed_query_params",
              "mutation_effects"
            ],
            "type": "object"
          },
          "maxItems": 64,
          "minItems": 1,
          "type": "array"
        },
        "outcome": {
          "enum": [
            "act",
            "wait",
            "ask",
            "stop"
          ],
          "type": "string"
        },
        "owner_alert": {
          "description": "WAIT only, when the policy grants owner_alerts: the one finding the owner asked to hear about, in a sentence.",
          "maxLength": 500,
          "type": "string"
        },
        "owner_alerts": {
          "description": "create/update: true when the owner asked to be told what the mandate finds (e.g. tell me when it is down). Lets a review's WAIT carry owner_alert; grants no tool, target or effect.",
          "type": "boolean"
        },
        "priority": {
          "description": "Create only controller scheduling priority. Updates preserve the existing priority and ignore this field.",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ],
          "type": "string"
        },
        "question": {
          "maxLength": 500,
          "type": "string"
        },
        "rationale": {
          "maxLength": 2048,
          "type": "string"
        },
        "reconciliation_resolution": {
          "enum": [
            "confirmed_effect_occurred",
            "confirmed_no_effect",
            "abandon_attempt"
          ],
          "type": "string"
        },
        "reconsider_minutes": {
          "minimum": 1,
          "type": "integer"
        },
        "review_effort": {
          "enum": [
            "efficient",
            "balanced",
            "thorough"
          ],
          "type": "string"
        },
        "risk": {
          "description": "ACT: expected cost or downside, or why none is material.",
          "maxLength": 4096,
          "type": "string"
        },
        "section": {
          "enum": [
            "summary",
            "policy",
            "history"
          ],
          "type": "string"
        },
        "source_goal_id": {
          "description": "Create only. Optional provenance link to a personal goal created in this exact private owner session; omit it when no compatible goal exists. Updates preserve the existing binding and ignore this field.",
          "maxLength": 256,
          "type": "string"
        },
        "stop_conditions": {
          "description": "Owner-facing reason to stop. Use one short plain-language condition per item.",
          "items": {
            "maxLength": 500,
            "type": "string"
          },
          "maxItems": 16,
          "type": "array"
        },
        "strategy_confidence_bps": {
          "maximum": 10000,
          "minimum": 0,
          "type": "integer"
        },
        "strategy_key": {
          "maxLength": 64,
          "type": "string"
        },
        "strategy_kind": {
          "enum": [
            "reinforce",
            "explore",
            "avoid",
            "retire"
          ],
          "type": "string"
        },
        "strategy_skill": {
          "maxLength": 256,
          "type": "string"
        },
        "success_criteria": {
          "description": "Owner-facing, observable success measure. Use one short plain-language result per item.",
          "items": {
            "maxLength": 500,
            "type": "string"
          },
          "maxItems": 16,
          "type": "array"
        },
        "target_session_id": {
          "description": "transfer_owner only; exact registered destination session",
          "maxLength": 256,
          "type": "string"
        },
        "termination_kind": {
          "description": "STOP only; omit for ACT, WAIT, and ASK.",
          "enum": [
            "success_criteria_satisfied",
            "stop_condition_met",
            "safety_termination"
          ],
          "type": "string"
        },
        "termination_match": {
          "description": "STOP only; omit for ACT, WAIT, and ASK.",
          "maxLength": 500,
          "type": "string"
        },
        "value_criterion": {
          "description": "ACT: exact owner-confirmed success criterion advanced; legacy uses the exact objective.",
          "maxLength": 2048,
          "type": "string"
        }
      },
      "required": [
        "action"
      ],
      "type": "object"
    }
  }
}
