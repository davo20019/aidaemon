{
  "description": "OAuth. Secrets never in args: owner runs `aidaemon keychain set <key>`. Inspect first; connect reauthorizes; bind_account proves identity. Manual auth → manage_http_auth.",
  "name": "manage_oauth",
  "schema": {
    "description": "OAuth. Secrets never in args: owner runs `aidaemon keychain set <key>`. Inspect first; connect reauthorizes; bind_account proves identity. Manual auth → manage_http_auth.",
    "name": "manage_oauth",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "account_id": {
          "maxLength": 256,
          "type": "string"
        },
        "account_id_pointer": {
          "type": "string"
        },
        "action": {
          "enum": [
            "connect",
            "list",
            "bind_account",
            "remove",
            "set_credentials",
            "refresh",
            "providers",
            "describe_provider",
            "register_provider",
            "remove_provider"
          ],
          "type": "string"
        },
        "allowed_domains": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "auth_type": {
          "enum": [
            "oauth2_pkce",
            "oauth2_authorization_code",
            "oauth2_client_credentials"
          ],
          "type": "string"
        },
        "authorize_url": {
          "type": "string"
        },
        "client_id": {
          "type": "string"
        },
        "confirm_disconnect": {
          "description": "Must be true with remove; use connect to reauthorize",
          "type": "boolean"
        },
        "display_name": {
          "type": "string"
        },
        "identity_url": {
          "type": "string"
        },
        "scopes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "service": {
          "type": "string"
        },
        "token_url": {
          "type": "string"
        }
      },
      "required": [
        "action"
      ],
      "type": "object"
    }
  }
}
