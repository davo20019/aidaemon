{
  "description": "HTTP auth CRUD; keychain secrets; verify refreshes.",
  "name": "manage_http_auth",
  "schema": {
    "description": "HTTP auth CRUD; keychain secrets; verify refreshes.",
    "name": "manage_http_auth",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "list",
            "describe",
            "upsert",
            "remove",
            "verify"
          ],
          "type": "string"
        },
        "allowed_domains": {
          "description": "Auth hosts",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "auth_type": {
          "enum": [
            "oauth1a",
            "bearer",
            "header",
            "basic"
          ],
          "type": "string"
        },
        "header_name": {
          "description": "header auth",
          "type": "string"
        },
        "method": {
          "enum": [
            "GET",
            "HEAD"
          ],
          "type": "string"
        },
        "profile": {
          "type": "string"
        },
        "timeout_secs": {
          "type": "integer"
        },
        "url": {
          "type": "string"
        },
        "user_id": {
          "description": "OAuth1a account ID; pause/revoke mandates before rebind, then reconfirm.",
          "type": "string"
        },
        "username": {
          "description": "basic",
          "type": "string"
        }
      },
      "required": [
        "action"
      ],
      "type": "object"
    }
  }
}
