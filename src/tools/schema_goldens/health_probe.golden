              "description": "Expected exit code",
              "type": "integer"
            },
            "expected_status": {
              "description": "Expected HTTP status",
              "type": "integer"
            },
            "max_age_secs": {
              "description": "Max file age",
              "type": "integer"
            },
            "method": {
              "type": "string"
            },
            "timeout_secs": {
              "type": "integer"
            }
          },
          "type": "object"
        },
