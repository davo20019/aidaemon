{
  "description": "Memories/goals. search=facts; search_episodes=past chats. Store via remember_fact.",
  "name": "manage_memories",
  "schema": {
    "description": "Memories/goals. search=facts; search_episodes=past chats. Store via remember_fact.",
    "name": "manage_memories",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "list",
            "health",
            "repair",
            "forget",
            "set_privacy",
            "search",
            "search_episodes",
            "create_personal_goal",
            "list_goals",
            "complete_goal",
            "abandon_goal",
            "create_scheduled_goal",
            "activate_scheduled",
            "list_scheduled",
            "list_scheduled_matching",
            "add_schedule",
            "cancel_scheduled",
            "pause_scheduled",
            "resume_scheduled",
            "retry_scheduled",
            "retry_failed_scheduled",
            "cancel_scheduled_matching",
            "retry_scheduled_matching",
            "diagnose_scheduled"
          ],
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "fire_policy": {
          "enum": [
            "coalesce",
            "always_fire"
          ],
          "type": "string"
        },
        "goal": {
          "type": "string"
        },
        "goal_id": {
          "type": "string"
        },
        "is_one_shot": {
          "type": "boolean"
        },
        "is_paused": {
          "type": "boolean"
        },
        "key": {
          "type": "string"
        },
        "limit": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "priority": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ],
          "type": "string"
        },
        "privacy": {
          "enum": [
            "global",
            "channel",
            "private"
          ],
          "type": "string"
        },
        "query": {
          "type": "string"
        },
        "schedule": {
          "type": "string"
        },
        "schedule_id": {
          "type": "string"
        },
        "schedules": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "action"
      ],
      "type": "object"
    }
  }
}
