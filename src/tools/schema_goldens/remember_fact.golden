{
  "description": "Store or forget stable user/environment facts, not task research, generated content, goals, or schedules. Use personal_memory for people and relationships.",
  "name": "remember_fact",
  "schema": {
    "description": "Store or forget stable user/environment facts, not task research, generated content, goals, or schedules. Use personal_memory for people and relationships.",
    "name": "remember_fact",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "type": "string"
        },
        "delete": {
          "description": "Forget category/key; value is ignored.",
          "type": "boolean"
        },
        "facts": {
          "items": {
            "properties": {
              "category": {
                "type": "string"
              },
              "delete": {
                "description": "Forget this fact; value is ignored.",
                "type": "boolean"
              },
              "key": {
                "type": "string"
              },
              "value": {
                "description": "Stored as written, including \"none\".",
                "type": "string"
              }
            },
            "required": [
              "category",
              "key"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "key": {
          "type": "string"
        },
        "personal_memory": {
          "additionalProperties": false,
          "properties": {
            "aliases": {
              "items": {
                "properties": {
                  "alias_type": {
                    "enum": [
                      "legal_name_variant",
                      "preferred_name",
                      "nickname",
                      "username",
                      "online_handle",
                      "account_name"
                    ],
                    "type": "string"
                  },
                  "entity_local_id": {
                    "type": "string"
                  },
                  "value": {
                    "type": "string"
                  }
                },
                "required": [
                  "entity_local_id",
                  "value",
                  "alias_type"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "correction": {
              "type": "boolean"
            },
            "direct_user_statement": {
              "type": "boolean"
            },
            "entities": {
              "items": {
                "properties": {
                  "canonical_name": {
                    "type": "string"
                  },
                  "canonical_name_confirmed": {
                    "type": "boolean"
                  },
                  "entity_type": {
                    "enum": [
                      "person",
                      "organization",
                      "project",
                      "place",
                      "account"
                    ],
                    "type": "string"
                  },
                  "is_reference": {
                    "description": "Resolve existing alias/name; false declares.",
                    "type": "boolean"
                  },
                  "local_id": {
                    "type": "string"
                  }
                },
                "required": [
                  "local_id",
                  "entity_type",
                  "canonical_name"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "facts": {
              "items": {
                "properties": {
                  "display_value": {
                    "type": "string"
                  },
                  "predicate": {
                    "type": "string"
                  },
                  "subject_local_id": {
                    "type": "string"
                  },
                  "valid_from": {
                    "type": "string"
                  },
                  "valid_to": {
                    "type": "string"
                  },
                  "value": {
                    "type": "string"
                  }
                },
                "required": [
                  "subject_local_id",
                  "predicate",
                  "value"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "relationships": {
              "items": {
                "properties": {
                  "relationship_type": {
                    "enum": [
                      "PARENT_OF",
                      "CHILD_OF",
                      "LIVES_WITH",
                      "LIVES_IN",
                      "USES_ALIAS",
                      "USES_HANDLE",
                      "HAS_ACCOUNT"
                    ],
                    "type": "string"
                  },
                  "source_local_id": {
                    "type": "string"
                  },
                  "target_local_id": {
                    "type": "string"
                  },
                  "valid_from": {
                    "type": "string"
                  },
                  "valid_to": {
                    "type": "string"
                  }
                },
                "required": [
                  "source_local_id",
                  "relationship_type",
                  "target_local_id"
                ],
                "type": "object"
              },
              "type": "array"
            }
          },
          "type": "object"
        },
        "value": {
          "description": "Stored as written, including \"none\".",
          "type": "string"
        }
      },
      "type": "object"
    }
  }
}
