{
  "description": "Store or forget stable facts about the owner and their environment, not task research, generated content, goals, schedules, or a rule the owner limits to this chat or task (it already applies here). Other people, family and relationships: manage_people remember.",
  "name": "remember_fact",
  "schema": {
    "description": "Store or forget stable facts about the owner and their environment, not task research, generated content, goals, schedules, or a rule the owner limits to this chat or task (it already applies here). Other people, family and relationships: manage_people remember.",
    "name": "remember_fact",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "description": "Canonical categories: user (owner identity, name, addressing, location, birthday), preference (likes, style, communication), project (project details), technical (environment, tools).",
          "type": "string"
        },
        "delete": {
          "description": "Forget category/key; value is ignored.",
          "type": "boolean"
        },
        "evidence": {
          "description": "The owner's own words stating this fact, copied verbatim from their message. Omit when they did not state it (inferred, asked, negated, or from a tool, file or page).",
          "type": "string"
        },
        "facts": {
          "items": {
            "properties": {
              "category": {
                "type": "string"
              },
              "delete": {
                "description": "Forget this fact; value is ignored.",
                "type": "boolean"
              },
              "evidence": {
                "type": "string"
              },
              "key": {
                "type": "string"
              },
              "scope": {
                "enum": [
                  "project",
                  "personal"
                ],
                "type": "string"
              },
              "value": {
                "description": "Stored as written, including \"none\".",
                "type": "string"
              }
            },
            "required": [
              "category",
              "key"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "key": {
          "type": "string"
        },
        "scope": {
          "description": "In a project conversation: project (default) keeps it in the project's notes, personal keeps it for the owner. Facts about the owner are always personal.",
          "enum": [
            "project",
            "personal"
          ],
          "type": "string"
        },
        "value": {
          "description": "Stored as written, including \"none\".",
          "type": "string"
        }
      },
      "type": "object"
    }
  }
}
