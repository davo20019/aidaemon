{
  "description": "Manage runs.",
  "name": "scheduled_goal_runs",
  "schema": {
    "description": "Manage runs.",
    "name": "scheduled_goal_runs",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "overview",
            "run_now",
            "run_history",
            "last_failure",
            "unblock_hints",
            "set_budget",
            "update_instructions",
            "bind_workspace"
          ],
          "type": "string"
        },
        "budget_daily": {
          "type": "integer"
        },
        "budget_per_check": {
          "type": "integer"
        },
        "goal_id": {
          "description": "id/prefix/objective phrase",
          "type": "string"
        },
        "include_diagnostics": {
          "type": "boolean"
        },
        "instructions": {
          "type": "string"
        },
        "insufficient_evidence": {
          "enum": [
            "use_public_sources",
            "use_best_available",
            "skip_run"
          ],
          "type": "string"
        },
        "limit": {
          "type": "integer"
        },
        "run_requirement": {
          "enum": [
            "must_complete",
            "best_effort"
          ],
          "type": "string"
        },
        "schedule_id": {
          "type": "string"
        },
        "workspace_path": {
          "type": "string"
        }
      },
      "required": [
        "action"
      ],
      "type": "object"
    }
  }
}
