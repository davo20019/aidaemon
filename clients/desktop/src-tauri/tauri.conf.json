{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AIdaemon",
  "version": "0.1.0",
  "identifier": "ai.aidaemon.desktop",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build:web",
    "beforeDevCommand": "npm run build:web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AIdaemon",
        "width": 1100,
        "height": 720,
        "minWidth": 420,
        "minHeight": 360
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' data:",
      "dangerousDisableAssetCspModification": false
    }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "shortDescription": "Your AIdaemon, in a window and the tray",
    "targets": ["app", "dmg", "appimage", "deb", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
