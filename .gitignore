*.json
# Protocol fixtures compiled into tests (include_str!).
!tests/fixtures/**/*.json
# The Client Protocol's generated JSON Schema, which clients generate from.
!schemas/**/*.json
# The web client's manifest and compiler settings (its build output is
# copied into crates/aidaemon-client-gateway/web).
!clients/web/*.json
clients/web/dist/
# The desktop app's manifests, Tauri config, capabilities and icons; its
# copy of the web build and Tauri's outputs are generated.
!clients/desktop/*.json
!clients/desktop/src-tauri/*.json
!clients/desktop/src-tauri/capabilities/*.json
clients/desktop/dist/
clients/desktop/node_modules/
clients/desktop/src-tauri/target/
clients/desktop/src-tauri/gen/
